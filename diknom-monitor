def cache_sizes():
    base = "/sys/devices/system/cpu/cpu0/cache"
    l1d = l1i = l2 = l3 = ""
    try:
        for entry in os.listdir(base):
            level = read_int(os.path.join(base, entry, "level"))
            typ = read(os.path.join(base, entry, "type"))
            size = read(os.path.join(base, entry, "size"))
            if level == 1 and typ == "Data":
                l1d = size
            elif level == 1 and typ == "Instruction":
                l1i = size
            elif level == 2:
                l2 = size
            elif level == 3:
                l3 = size
    except Exception:
        pass
    l1 = ""
    if l1d or l1i:
        l1 = f"{l1d} (data) + {l1i} (instruksi)" if l1d and l1i else (l1d or l1i)
    return l1, l2, l3


def _first_line(text):
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()
    return ""


def _sysfs_disk_name(part):
    part = os.path.basename(part or "")
    for pattern in (r"^(mmcblk\d+|nvme\d+n\d+|md\d+|loop\d+)(?:p\d+)?$",
                    r"^(sd[a-z]+|vd[a-z]+|hd[a-z]+)\d*$"):
        m = re.match(pattern, part)
        if m:
            return m.group(1)
    return part


def _fs_type(mount):
    try:
        for part in psutil.disk_partitions(all=False):
            if part.mountpoint == mount:
                return part.fstype or "-"
    except Exception:
        pass
    return "-"


def _linux_disk_type(name):
    if not name:
        return "-"
    if name.startswith("mmcblk"):
        return "eMMC"
    if name.startswith("nvme"):
        return "NVMe SSD"
    if name.startswith("zram"):
        return "ZRAM"
    if name.startswith(("sd", "vd", "hd")):
        rotational = read(f"/sys/block/{name}/queue/rotational")
        if rotational == "1":
            return "HDD"
        if rotational == "0":
            return "SSD"
    return "-"


def disk_info():
    """Model, ukuran, dan tipe disk, lintas OS sejauh data tersedia."""
    model, size, dtype = "-", 0, "-"
    if OS_NAME == "Linux":
        names = []
        try:
            for p in psutil.disk_partitions(all=False):
                if p.mountpoint == "/":
                    names.append(_sysfs_disk_name(p.device))
        except Exception:
            pass
        names += ["mmcblk0", "nvme0n1", "sda"]
        for name in names:
            if not name:
                continue
            for path in (f"/sys/block/{name}/device/model",
                         f"/sys/block/{name}/device/name"):
                value = read(path)
                if value:
                    model = value
                    break
            sz = read_int(f"/sys/block/{name}/size") * 512
            if sz:
                size = sz
            dtype = _linux_disk_type(name)
            if model != "-" or size:
                break
    elif OS_NAME == "Windows":
        out = powershell("Get-PhysicalDisk | Select-Object -First 1 "
                         "FriendlyName,MediaType,Size | ConvertTo-Json -Compress")
        try:
            data = json.loads(out) if out else {}
            model = data.get("FriendlyName") or "-"
            size = int(data.get("Size") or 0)
            media = data.get("MediaType")
            dtype = {3: "HDD", 4: "SSD", 5: "SCM"}.get(media, "-")
        except Exception:
            pass
    elif OS_NAME == "Darwin":
        out = run_cmd(["diskutil", "info", "/"], timeout=6)
        for line in out.splitlines():
            if "Device / Media Name:" in line:
                model = line.split(":", 1)[1].strip()
            elif "Disk Size:" in line:
                m = re.search(r"\((\d+) Bytes\)", line)
                if m:
                    size = int(m.group(1))
            elif "Solid State:" in line:
                dtype = "SSD" if "Yes" in line else "HDD"
    if not size:
        try:
            size = psutil.disk_usage(ROOT_MOUNT).total
        except Exception:
            pass
    return model, size, dtype


def win_hw_info():
    if OS_NAME != "Windows":
        return {}
    command = (
        "$cs=Get-CimInstance Win32_ComputerSystem;"
        "$bb=Get-CimInstance Win32_BaseBoard;"
        "$b=Get-CimInstance Win32_BIOS;"
        "$g=Get-CimInstance Win32_VideoController | Select-Object -First 1;"
        "[pscustomobject]@{vendor=$cs.Manufacturer;product=$cs.Model;"
        "board=$bb.Product;bios=$b.SMBIOSBIOSVersion;"
        "bios_date=([string]$b.ReleaseDate);gpu=$g.Name} | "
        "ConvertTo-Json -Compress")
    out = powershell(command, timeout=8)
    try:
        return json.loads(out) if out else {}
    except Exception:
        return {}


def mac_hw_info():
    if OS_NAME != "Darwin":
        return {}
    info = {"vendor": "Apple Inc."}
    out = run_cmd(["system_profiler", "SPHardwareDataType"], timeout=8)
    for line in out.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if key == "Model Name":
            info["product"] = value
        elif key == "Model Identifier":
            info["board"] = value
        elif key in ("Boot ROM Version", "System Firmware Version"):
            info.setdefault("bios", value)
    out = run_cmd(["system_profiler", "SPDisplaysDataType"], timeout=8)
    for line in out.splitlines():
        if "Chipset Model:" in line:
            info["gpu"] = line.split(":", 1)[1].strip()
            break
    return info


def collect_hw():
    hw = {"os_family": OS_NAME}
    cpuinfo = read("/proc/cpuinfo") if OS_NAME == "Linux" else ""
    m = re.search(r"model name\s*:\s*(.+)", cpuinfo)
    model = m.group(1).strip() if m else ""
    if not model and OS_NAME == "Windows":
        model = _first_line(powershell(
            "(Get-CimInstance Win32_Processor | Select-Object -First 1).Name"))
    if not model and OS_NAME == "Darwin":
        model = run_cmd(["sysctl", "-n", "machdep.cpu.brand_string"])
    hw["cpu_model"] = model or platform.processor() or "CPU"
    m = re.search(r"@\s*([\d.]+)\s*GHz", hw["cpu_model"])
    hw["base_ghz"] = float(m.group(1)) if m else 0.0
    hw["arch"] = platform.machine()
    hw["cores"] = psutil.cpu_count(logical=False) or 1
    hw["threads"] = psutil.cpu_count(logical=True) or 1
    l1, l2, l3 = cache_sizes()
    hw["l1"], hw["l2"], hw["l3"] = l1, l2, l3
    hw["governor"] = read(
        "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor", "-")
    try:
        hw["boost"] = psutil.cpu_freq().max
    except Exception:
        hw["boost"] = 0

    hw["product"] = hw["vendor"] = hw["board"] = hw["bios"] = "-"
    hw["bios_date"] = ""
    if OS_NAME == "Linux":
        hw["product"] = read("/sys/class/dmi/id/product_name", "-")
        hw["vendor"] = read("/sys/class/dmi/id/sys_vendor", "-")
        hw["board"] = read("/sys/class/dmi/id/board_name", "-")
        hw["bios"] = read("/sys/class/dmi/id/bios_version", "-")
        hw["bios_date"] = read("/sys/class/dmi/id/bios_date", "")
    elif OS_NAME == "Windows":
        info = win_hw_info()
        hw["product"] = info.get("product") or "-"
        hw["vendor"] = info.get("vendor") or "-"
        hw["board"] = info.get("board") or "-"
        hw["bios"] = info.get("bios") or "-"
        hw["bios_date"] = info.get("bios_date") or ""
        hw["gpu"] = info.get("gpu") or "-"
    elif OS_NAME == "Darwin":
        info = mac_hw_info()
        hw["product"] = info.get("product") or "-"
        hw["vendor"] = info.get("vendor") or "-"
        hw["board"] = info.get("board") or "-"
        hw["bios"] = info.get("bios") or "-"
        hw["gpu"] = info.get("gpu") or "-"

    hw["kernel"] = platform.release()
    if OS_NAME == "Linux":
        osrel = {}
        for line in read("/etc/os-release").splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                osrel[k] = v.strip('"')
        hw["os"] = osrel.get("PRETTY_NAME", "Linux")
    elif OS_NAME == "Windows":
        hw["os"] = platform.platform()
    elif OS_NAME == "Darwin":
        hw["os"] = "macOS " + (platform.mac_ver()[0] or platform.release())
    else:
        hw["os"] = platform.platform()

    hw["hostname"] = platform.node()
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "")
    if not desktop and OS_NAME == "Linux" and run_cmd(["pgrep", "-x", "xfdesktop"]):
        desktop = "XFCE"
    hw["desktop"] = desktop or {"Windows": "Windows", "Darwin": "macOS"}.get(
        OS_NAME, OS_NAME)

    if "gpu" not in hw:
        hw["gpu"] = "-"
        for line in run_cmd(["lspci"]).splitlines():
            if re.search(r"VGA compatible|3D controller|Display controller",
                         line, re.I):
                hw["gpu"] = line.split(":", 2)[-1].strip()
                break

    hw["disk_model"], hw["disk_size"], hw["disk_type"] = disk_info()
    hw["bat"] = {}
    if OS_NAME == "Linux":
        for key in ("capacity", "status", "power_now", "energy_now",
                    "energy_full", "energy_full_design", "voltage_now"):
            val = read("/sys/class/power_supply/BAT0/" + key)
            if val:
                hw["bat"][key] = val
    return hw


def temp_slots():
    """Daftar sensor suhu yang akan ditampilkan (stabil sepanjang sesi)."""
    slots = []
    try:
        sensors = psutil.sensors_temperatures()
    except Exception:
        sensors = {}
    if "coretemp" in sensors:
        for e in sensors["coretemp"]:
            label = e.label or "Core"
            if label.startswith("Package"):
                slots.append(("CPU Package", "coretemp", e.label))
            elif label.startswith("Core"):
                display = label.replace("Core", "Core").strip()
                slots.append((display, "coretemp", e.label))
    if "acpitz" in sensors:
        for e in sensors["acpitz"][:1]:
            slots.append(("Motherboard (ACPI)", "acpitz", e.label))
    for chip in ("k10temp", "zenpower", "it8xxx2", "nct6775", "thinkpad"):
        if chip in sensors:
            for e in sensors[chip][:1]:
                label = e.label or chip
                slots.append((f"{chip.upper()} {label}".strip(), chip, e.label))
    return slots


