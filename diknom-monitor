def draw_icon(c, kind, x, y, s, color, lw=None):
    lw = lw or max(1, int(round(s / 10.0)))

    def line(*a, **k):
        k.setdefault("fill", color)
        k.setdefault("width", lw)
        k.setdefault("capstyle", "round")
        return c.create_line(*a, **k)

    def rect(x1, y1, x2, y2, **k):
        k.setdefault("outline", color)
        k.setdefault("width", lw)
        return c.create_rectangle(x + x1 * s, y + y1 * s, x + x2 * s, y + y2 * s, **k)

    def oval(x1, y1, x2, y2, **k):
        k.setdefault("outline", color)
        k.setdefault("width", lw)
        return c.create_oval(x + x1 * s, y + y1 * s, x + x2 * s, y + y2 * s, **k)

    if kind == "cpu":
        rect(.24, .24, .76, .76)
        rect(.40, .40, .60, .60)
        for k in (.34, .50, .66):
            line(x + k * s, y + .10 * s, x + k * s, y + .24 * s)
            line(x + k * s, y + .76 * s, x + k * s, y + .90 * s)
            line(x + .10 * s, y + k * s, x + .24 * s, y + k * s)
            line(x + .76 * s, y + k * s, x + .90 * s, y + k * s)
    elif kind == "ram":
        rect(.08, .34, .92, .66)
        for k in (.30, .50, .70):
            line(x + k * s, y + .34 * s, x + k * s, y + .66 * s)
        for k in (.18, .34, .50, .66, .82):
            line(x + k * s, y + .66 * s, x + k * s, y + .84 * s)
    elif kind == "zram":
        rect(.16, .16, .84, .42)
        rect(.16, .50, .84, .76)
        line(x + .30 * s, y + .60 * s, x + .70 * s, y + .60 * s)
        line(x + .30 * s, y + .67 * s, x + .70 * s, y + .67 * s)
    elif kind == "swap":
        line(x + .16 * s, y + .38 * s, x + .80 * s, y + .38 * s)
        line(x + .68 * s, y + .26 * s, x + .82 * s, y + .38 * s)
        line(x + .68 * s, y + .50 * s, x + .82 * s, y + .38 * s)
        line(x + .84 * s, y + .62 * s, x + .20 * s, y + .62 * s)
        line(x + .32 * s, y + .50 * s, x + .18 * s, y + .62 * s)
        line(x + .32 * s, y + .74 * s, x + .18 * s, y + .62 * s)
    elif kind == "disk":
        oval(.18, .10, .82, .32)
        line(x + .18 * s, y + .21 * s, x + .18 * s, y + .78 * s)
        line(x + .82 * s, y + .21 * s, x + .82 * s, y + .78 * s)
        c.create_arc(x + .18 * s, y + .67 * s, x + .82 * s, y + .89 * s,
                     start=180, extent=180, style="arc", outline=color, width=lw)
        line(x + .40 * s, y + .21 * s, x + .60 * s, y + .21 * s)
    elif kind == "net":
        oval(.10, .10, .90, .90)
        line(x + .10 * s, y + .50 * s, x + .90 * s, y + .50 * s)
        oval(.32, .10, .68, .90)
    elif kind == "temp":
        line(x + .54 * s, y + .10 * s, x + .54 * s, y + .62 * s, width=lw + 1)
        oval(.36, .56, .72, .92)
        c.create_oval(x + .44 * s, y + .64 * s, x + .64 * s, y + .84 * s,
                      fill=color, outline="")
        line(x + .66 * s, y + .26 * s, x + .78 * s, y + .26 * s)
        line(x + .66 * s, y + .40 * s, x + .78 * s, y + .40 * s)
    elif kind == "gear":
        oval(.30, .30, .70, .70)
        import math
        for i in range(8):
            a = math.radians(i * 45)
            r1, r2 = .24, .40
            line(x + (.5 + r1 * math.cos(a)) * s, y + (.5 + r1 * math.sin(a)) * s,
                 x + (.5 + r2 * math.cos(a)) * s, y + (.5 + r2 * math.sin(a)) * s)
    elif kind == "list":
        for k in (.24, .50, .76):
            c.create_oval(x + .12 * s, y + (k - .035) * s, x + .19 * s, y + (k + .035) * s,
                          fill=color, outline="")
            line(x + .30 * s, y + k * s, x + .88 * s, y + k * s)
    elif kind == "gauge":
        c.create_arc(x + .10 * s, y + .14 * s, x + .90 * s, y + .94 * s,
                     start=210, extent=-240, style="arc", outline=color, width=lw)
        line(x + .50 * s, y + .58 * s, x + .72 * s, y + .30 * s)
        c.create_oval(x + .45 * s, y + .53 * s, x + .55 * s, y + .63 * s,
                      fill=color, outline="")
    elif kind == "home":
        line(x + .12 * s, y + .48 * s, x + .50 * s, y + .12 * s, x + .88 * s, y + .48 * s)
        line(x + .22 * s, y + .44 * s, x + .22 * s, y + .86 * s, x + .78 * s, y + .86 * s,
             x + .78 * s, y + .44 * s)
    elif kind == "battery":
        rect(.08, .30, .80, .70)
        rect(.80, .40, .90, .60)
        for x1 in (.16, .38, .60):
            c.create_rectangle(x + x1 * s, y + .38 * s,
                               x + (x1 + .16) * s, y + .62 * s,
                               fill=color, outline="")
    elif kind == "info":
        oval(.12, .12, .88, .88)
        c.create_oval(x + .46 * s, y + .26 * s, x + .54 * s, y + .34 * s,
                      fill=color, outline="")
        line(x + .50 * s, y + .44 * s, x + .50 * s, y + .72 * s, width=lw + 1)
    return c


def make_icon(parent, kind, size=16, color=MUTED, bg=CARD):
    c = tk.Canvas(parent, width=size, height=size, bg=bg,
                  highlightthickness=0, bd=0)
    draw_icon(c, kind, 0, 0, size, color)
    return c


def draw_monitor(c, x, y, w, h, color, accent=GREEN):
    c.create_rectangle(x, y, x + w, y + h * .70, outline=color, width=2)
    c.create_line(x + w * .40, y + h * .70, x + w * .40, y + h * .86,
                  fill=color, width=2)
    c.create_line(x + w * .60, y + h * .70, x + w * .60, y + h * .86,
                  fill=color, width=2)
    c.create_line(x + w * .26, y + h * .86, x + w * .74, y + h * .86,
                  fill=color, width=2)
    pts = []
    import math
    for i in range(28):
        px = x + w * .10 + (w * .80) * i / 27.0
        py = y + h * .36 - math.sin(i / 3.3) * h * .10
        pts.extend([px, py])
    c.create_line(*pts, fill=accent, width=2, smooth=True)


