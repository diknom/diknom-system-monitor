def read_battery():
    info = {}
    base = "/sys/class/power_supply/BAT0"
    if os.path.isdir(base):
        def val(name):
            return read(base + "/" + name, "")

        def num(name):
            try:
                return float(val(name) or 0)
            except Exception:
                return 0.0

        info = {
            "present": read_int(base + "/present", 1) == 1,
            "percent": num("capacity"),
            "status": val("status") or "Unknown",
            "energy_now": num("energy_now") / 1e6,
            "energy_full": num("energy_full") / 1e6,
            "energy_design": num("energy_full_design") / 1e6,
            "power": num("power_now") / 1e6,
            "voltage": num("voltage_now") / 1e6,
            "cycles": read_int(base + "/cycle_count", -1),
            "technology": val("technology") or "-",
            "model": val("model_name") or "-",
            "manufacturer": val("manufacturer") or "-",
            "ac_online": read_int(
                "/sys/class/power_supply/ADP1/online", -1) == 1,
        }
        # Sebagian laptop hanya menyediakan charge_*; ubah ke Wh.
        if info["energy_full"] == 0:
            charge = num("charge_full")
            if charge > 0 and info["voltage"] > 0:
                info["energy_full"] = charge * info["voltage"] / 1e12
        if info["energy_design"] == 0:
            charge = num("charge_full_design")
            if charge > 0 and info["voltage"] > 0:
                info["energy_design"] = charge * info["voltage"] / 1e12
        if info["energy_now"] == 0:
            charge = num("charge_now")
            if charge > 0 and info["voltage"] > 0:
                info["energy_now"] = charge * info["voltage"] / 1e12

    sb = None
    try:
        sb = psutil.sensors_battery()
    except Exception:
        pass
    if not info and not sb:
        return None

    info.setdefault("present", True)
    info.setdefault("percent", 0.0)
    info.setdefault("status", "Unknown")
    info.setdefault("energy_now", 0.0)
    info.setdefault("energy_full", 0.0)
    info.setdefault("energy_design", 0.0)
    info.setdefault("power", 0.0)
    info.setdefault("voltage", 0.0)
    info.setdefault("cycles", -1)
    info.setdefault("technology", "-")
    info.setdefault("model", "-")
    info.setdefault("manufacturer", "-")
    info.setdefault("ac_online", False)

    for key, value in battery_static_extra().items():
        if key in ("energy_design", "energy_full", "cycles", "technology",
                   "model", "manufacturer", "health"):
            if value not in (None, "", 0):
                info[key] = value
        elif key == "condition" and LANG == "id":
            info.setdefault("condition", value)

    if sb:
        info["plugged"] = bool(sb.power_plugged)
        info["secsleft"] = sb.secsleft
        if sb.percent is not None:
            info["percent"] = sb.percent
        if OS_NAME != "Linux":
            info["ac_online"] = bool(sb.power_plugged)
    else:
        info["plugged"] = bool(info.get("ac_online"))
        info["secsleft"] = None

    if not info.get("status") or info.get("status") == "Unknown":
        if info["plugged"]:
            info["status"] = "Full" if info["percent"] >= 99.5 else "Charging"
        else:
            info["status"] = "Discharging"

    if info.get("energy_design", 0) > 0:
        info["health"] = info["energy_full"] / info["energy_design"] * 100.0
    else:
        info.setdefault("health", None)
    return info


