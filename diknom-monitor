    def sort_procs(self, key):
        if self.proc_sort[0] == key:
            self.proc_sort = (key, not self.proc_sort[1])
        else:
            self.proc_sort = (key, key not in ("name", "user", "status", "pid"))
        for c, title in (("pid", "PID"),
                          ("name", "Process" if LANG == "en" else "Proses"),
                          ("user", "Pengguna"),
                          ("cpu", "CPU %"), ("ram", "RAM"), ("rampct", "RAM %"),
                          ("threads", "Thread"), ("status", "Status")):
            arrow = ""
            if c == self.proc_sort[0]:
                arrow = "  ▼" if self.proc_sort[1] else "  ▲"
            self.tree.heading(c, text=tr(title) + arrow,
                              command=lambda k=c: self.sort_procs(k))
        self.render_procs()

    def refresh_processes(self, force=False):
        now = time.time()
        if not force and now - self.proc_ts < 2:
            return
        if self.proc_thread and self.proc_thread.is_alive():
            return
        self.proc_thread = threading.Thread(target=self._proc_worker, daemon=True)
        self.proc_thread.start()

    def _proc_worker(self):
        now_m = time.monotonic()
        ncpu = psutil.cpu_count(logical=True) or 1
        hide_kernel = bool(self.cfg.get("hide_kernel", True))
        rows = []
        try:
            for p in psutil.process_iter(["pid", "name", "username", "status",
                                          "memory_info", "num_threads"]):
                try:
                    info = p.info
                    pid = info["pid"]
                    if pid <= 0:
                        continue
                    if (hide_kernel and OS_NAME == "Linux"
                            and not os.path.exists(f"/proc/{pid}/exe")):
                        continue
                    mem = info["memory_info"].rss if info["memory_info"] else 0
                    total = 0.0
                    try:
                        ct = p.cpu_times()
                        total = ct.user + ct.system
                    except Exception:
                        pass
                    prev = self.proc_prev.get(pid)
                    pct = 0.0
                    if prev and now_m > prev[1] + 0.001:
                        pct = max(0.0, (total - prev[0]) / (now_m - prev[1]) *
                                  100.0 / ncpu)
                    self.proc_prev[pid] = (total, now_m)
                    name = info["name"] or f"pid {pid}"
                    rows.append({
                        "pid": pid,
                        "name": name,
                        "user": info["username"] or "-",
                        "status": info["status"] or "-",
                        "cpu": pct,
                        "ram": mem,
                        "threads": info["num_threads"] or 0,
                    })
                except (psutil.NoSuchProcess, psutil.AccessDenied,
                        psutil.ZombieProcess):
                    continue
            # buang entri proses yang sudah mati
            alive = {r["pid"] for r in rows}
            for pid in list(self.proc_prev):
                if pid not in alive:
                    self.proc_prev.pop(pid, None)
            self.proc_rows = rows
            self.proc_ts = time.time()
        except Exception:
            pass

    def render_procs(self):
        if "tree" not in self.__dict__:
            return
        try:
            if not self.tree.winfo_exists():
                return
        except Exception:
            return
        rows = list(self.proc_rows)
        if not rows:
            return
        q = self.proc_search.get().strip().lower()
        if q:
            rows = [r for r in rows
                    if q in r["name"].lower() or q in r["user"].lower()
                    or q in str(r["pid"])]
        key, rev = self.proc_sort
        keys = {
            "pid": lambda r: r["pid"],
            "name": lambda r: r["name"].lower(),
            "user": lambda r: r["user"].lower(),
            "cpu": lambda r: r["cpu"],
            "ram": lambda r: r["ram"],
            "rampct": lambda r: r["ram"],
            "threads": lambda r: r["threads"],
            "status": lambda r: r["status"],
        }
        rows.sort(key=keys.get(key, keys["ram"]), reverse=rev)

        vm = psutil.virtual_memory()
        total_mem = vm.total
        total_rss = sum(r["ram"] for r in self.proc_rows)
        self.proc_summary.config(
            text=f"{len(self.proc_rows)} {tr('proses')}  ·  RAM "
                 f"{hbytes(vm.used)} / {hbytes(total_mem)} "
                 f"({vm.percent:.0f}%)  ·  RSS total {hbytes(total_rss)}")
        top = sorted(self.proc_rows, key=lambda r: r["ram"], reverse=True)[:3]
        self.proc_top.config(
            text=f"{tr('Pemakan RAM teratas:')}  " +
                 "   ·   ".join(f"{r['name']} {hbytes(r['ram'])}" for r in top))

        desired = []
        for r in rows:
            iid = str(r["pid"])
            vals = (r["pid"], r["name"], r["user"], fnum(r["cpu"], 1),
                    hbytes(r["ram"]) if r["ram"] >= 1048576
                    else f"{fnum(r['ram'] / 1048576.0, 1)} MB",
                    fnum(r["ram"] / total_mem * 100, 1),
                    r["threads"], status_text(r["status"]))
            tag = "hi" if r["ram"] / total_mem * 100 >= 5 else "odd"
            if r["pid"] == os.getpid():
                tag = "own"
            if self.tree.exists(iid):
                self.tree.item(iid, values=vals, tags=(tag,))
            else:
                self.tree.insert("", "end", iid=iid, values=vals, tags=(tag,))
            desired.append(iid)
        existing = set(self.tree.get_children())
        for iid in existing - set(desired):
            self.tree.delete(iid)
        # pastikan urutan sesuai
        for idx, iid in enumerate(desired):
            if self.tree.index(iid) != idx:
                self.tree.move(iid, "", idx)
        try:
            self.proc_stamp_lbl.config(
                text=f"{tr('Diperbarui')} " +
                     time.strftime("%H:%M:%S", time.localtime(self.proc_ts)))
        except Exception:
            pass

    def _show_dialog(self, title, message, buttons, wrap=430):
        win = tk.Toplevel(self)
        win.title(tr(title))
        win.configure(bg=CARD)
        win.resizable(False, False)
        win.transient(self)
        result = {"value": None}

        def close(value):
            result["value"] = value
            try:
                win.grab_release()
            except Exception:
                pass
            win.destroy()

        body = tk.Frame(win, bg=CARD)
        body.pack(fill="both", expand=True, padx=22, pady=(18, 14))
        tk.Label(body, text=message, bg=CARD, fg=TEXT, font=(FONT, 10),
                 justify="left", anchor="w", wraplength=wrap).pack(fill="x")
        row = tk.Frame(body, bg=CARD)
        row.pack(fill="x", pady=(16, 0))
        for text, value, color in buttons:
            fg = "#ffffff" if color not in (CARD_DARK,) else TEXT
            tk.Button(row, text=text, command=lambda v=value: close(v),
                      bg=color, fg=fg, activebackground=mix(color, "#ffffff", .15),
                      activeforeground=fg, relief="flat", bd=0, padx=16, pady=5,
                      cursor="hand2", font=(FONT, 9, "bold" if color != CARD_DARK
                                            else "normal")).pack(side="right", padx=(8, 0))
        win.bind("<Escape>", lambda e: close(None))
        win.protocol("WM_DELETE_WINDOW", lambda: close(None))
        win.update_idletasks()
        w = max(360, win.winfo_reqwidth())
        h = win.winfo_reqheight()
        px = self.winfo_rootx() + (self.winfo_width() - w) // 2
        py = self.winfo_rooty() + (self.winfo_height() - h) // 2
        win.geometry(f"{w}x{h}+{max(0, px)}+{max(0, py)}")
        win.grab_set()
        win.focus_force()
        self.wait_window(win)
        return result["value"]

    def proc_detail(self):
        sel = self.tree.selection()
        if not sel:
            return
        pid = int(sel[0])
        try:
            p = psutil.Process(pid)
            with p.oneshot():
                lines = [
                    f"{tr('Nama')}: {p.name()}",
                    f"PID: {pid}   PPID: {p.ppid()}",
                    f"{tr('Pengguna')}: {p.username()}",
                    f"{tr('Status')}: {status_text(p.status())}",
                    f"RAM (RSS): {hbytes(p.memory_info().rss)}",
                    f"{tr('Thread')}: {p.num_threads()}",
                    f"{tr('CPU waktu')}: {fnum(p.cpu_times().user, 1)} "
                    f"{tr('dtk')}",
                    f"Command: {' '.join(p.cmdline())[:180] or '-'}",
                ]
            self._show_dialog(f"{tr('Detail')} PID {pid}", "\n".join(lines),
                              [("Tutup", True, CARD_DARK)], wrap=520)
        except Exception as exc:
            self._show_dialog("Detail proses", str(exc),
                              [("Tutup", True, CARD_DARK)])

    def end_task(self):
        sel = self.tree.selection()
        if not sel:
            self._show_dialog("Akhiri tugas", tr("Pilih satu proses dulu."),
                              [("Tutup", True, CARD_DARK)])
            return
        pid = int(sel[0])
        name = self.tree.item(sel[0], "values")[1]
        if pid in (1, os.getpid()):
            self._show_dialog(
                "Akhiri tugas",
                tr("Proses ini dilindungi dan tidak bisa diakhiri."),
                [("Tutup", True, CARD_DARK)])
            return
        if LANG == "en":
            message = (f"End process '{name}' (PID {pid})?\n\n"
                       "Unsaved data in that application may be lost.")
        else:
            message = (f"Akhiri proses '{name}' (PID {pid})?\n\n"
                       "Data yang belum disimpan di aplikasi tersebut bisa hilang.")
        ok = self._show_dialog(
            "Akhiri tugas", message,
            [("Ya, akhiri", True, PINK), ("Batal", False, CARD_DARK)])
        if not ok:
            return
        try:
            proc = psutil.Process(pid)
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except psutil.TimeoutExpired:
                pass
            self.refresh_processes(force=True)
            self.after(800, lambda: self.refresh_processes(force=True))
        except Exception as exc:
            self._show_dialog("Gagal mengakhiri proses", str(exc),
                              [("Tutup", True, CARD_DARK)])

