def wifi_info(iface):
    info = {}
    if not iface or iface == "lo":
        return info
    if OS_NAME == "Windows":
        out = run_cmd(["netsh", "wlan", "show", "interfaces"], timeout=4)
        for line in out.splitlines():
            if ":" not in line:
                continue
            key, value = line.split(":", 1)
            key, value = key.strip().lower(), value.strip()
            if key == "ssid":
                info["ssid"] = value
            elif key == "signal":
                info["signal"] = value
            elif key == "channel":
                info["freq"] = f"{tr('Kanal')} {value}"
        return info
    out = run_cmd(["iw", "dev", iface, "link"])
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("SSID:"):
            info["ssid"] = line.split(":", 1)[1].strip()
        elif line.startswith("signal:"):
            info["signal"] = line.split(":", 1)[1].strip()
        elif line.startswith("freq:"):
            m = re.search(r"freq:\s*(\d+)", line)
            if m:
                info["freq"] = m.group(1) + " MHz"
        elif line.startswith("tx bitrate:"):
            m = re.search(r"tx bitrate:\s*([\d.]+)", line)
            if m:
                info["bitrate"] = f"{m.group(1)} Mb/s"
    if "ssid" not in info:
        out = run_cmd(["nmcli", "-t", "-f", "active,ssid,signal,chan,freq",
                       "dev", "wifi"])
        for line in out.splitlines():
            parts = line.split(":")
            if parts and parts[0] == "yes" and len(parts) > 1:
                info["ssid"] = parts[1]
                if len(parts) > 2:
                    info["signal"] = parts[2] + " %"
                break
    return info


