    def _wifi_line(self, wifi):
        parts = []
        if wifi.get("ssid"):
            parts.append(f"SSID {wifi['ssid']}")
        if wifi.get("signal"):
            parts.append(f"sinyal {wifi['signal']}")
        if wifi.get("bitrate"):
            parts.append(wifi["bitrate"].split()[0] + " Mb/s")
        if wifi.get("freq"):
            parts.append(wifi["freq"])
        return "  ·  ".join(parts) if parts else "Bukan koneksi Wi-Fi"

    def fill_network_tables(self):
        if "net_tree" not in self.__dict__:
            return
        self.net_tree.delete(*self.net_tree.get_children())
        addrs = psutil.net_if_addrs()
        stats = psutil.net_if_stats()
        counters = psutil.net_io_counters(pernic=True)
        try:
            import socket
            af_link = getattr(psutil, "AF_LINK", None) or getattr(
                socket, "AF_PACKET", None)
        except Exception:
            af_link = getattr(psutil, "AF_LINK", None)
        for i, (name, st) in enumerate(stats.items()):
            ip = "-"
            mac = "-"
            for a in addrs.get(name, []):
                if a.family == 2:
                    ip = a.address
                elif (af_link is not None and a.family == af_link
                      and a.address and a.address.count(":") == 5):
                    mac = a.address
            cn = counters.get(name)
            self.net_tree.insert(
                "", "end", values=(name, "UP" if st.isup else "DOWN", ip, mac,
                                   f"{st.speed} Mb/s" if st.speed else "-",
                                   hbytes(cn.bytes_recv) if cn else "-",
                                   hbytes(cn.bytes_sent) if cn else "-"),
                tags=("odd" if i % 2 else "",))
        # detail wifi
        if self.wifi_body.winfo_exists():
            for child in self.wifi_body.winfo_children():
                child.destroy()
            wifi = wifi_info(self.iface)
            rows = [
                ("SSID", wifi.get("ssid", "-")),
                ("Sinyal", wifi.get("signal", "-")),
                ("Frekuensi", wifi.get("freq", "-")),
                ("Kecepatan link", wifi.get("bitrate", "-")),
                ("Antarmuka", self.iface),
            ]
            for k, v in rows:
                row = tk.Frame(self.wifi_body, bg=CARD)
                row.pack(fill="x", pady=1)
                tk.Label(row, text=k, bg=CARD, fg=MUTED, font=(FONT, 9),
                         width=14, anchor="w").pack(side="left")
                tk.Label(row, text=v, bg=CARD, fg=TEXT, font=(FONT, 9),
                         anchor="w").pack(side="left")

    def update_network(self):
        m = self.m
        if not m:
            return
        rx = m.get("rx", 0)
        tx = m.get("tx", 0)
        self.net_page_big.config(text=speed(rx + tx))
        self.net_page_sub.config(text=f"↓ {speed(rx)}  ·  ↑ {speed(tx)}")
        self.net_page_spark.push((rx + tx) / 1048576.0)
        if int(time.time()) % 10 == 0:
            self.fill_network_tables()

