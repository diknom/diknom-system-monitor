    def _battery_text(self):
        bat = self.hw.get("bat", {})
        if not bat:
            return "Tidak terdeteksi"
        cap = bat.get("capacity")
        status = bat.get("status", "")
        return f"{cap}% · {status}" if cap else status or "-"

    def _power_text(self):
        bat = self.hw.get("bat", {})
        try:
            p = int(bat.get("power_now", 0)) / 1e6
            e = int(bat.get("energy_now", 0)) / 1e6
            full = int(bat.get("energy_full", 0)) / 1e6
            return f"{fnum(p, 2)} W · {fnum(e, 1)} / {fnum(full, 1)} Wh"
        except Exception:
            return "-"

