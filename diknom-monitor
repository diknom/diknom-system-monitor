def system_language():
    loc = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
           or os.environ.get("LANG") or "")
    if not loc:
        try:
            loc = locale.getlocale()[0] or ""
        except Exception:
            loc = ""
    return "id" if loc.lower().startswith("id") else "en"


def resolve_language(setting):
    if setting in ("id", "en"):
        return setting
    return system_language()


