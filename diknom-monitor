    def set_big(self, key, text, color=None):
        ref = self.w.get(key)
        if not ref:
            return
        text = str(text)
        if text.endswith("%"):
            num, unit = text[:-1], "%"
        elif " " in text:
            num, unit = text.rsplit(" ", 1)
        else:
            num, unit = text, ""
        ref["big"].config(text=num)
        ref["unit"].config(text=unit)
        if color:
            ref["big"].config(fg=color)
            ref["unit"].config(fg=color)

