def read(path, default=""):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except Exception:
        return default


def read_int(path, default=0):
    try:
        return int(read(path, str(default)))
    except Exception:
        return default


def fnum(value, dec=1):
    """Format angka sesuai bahasa aktif (koma untuk Indonesia)."""
    try:
        s = f"{float(value):,.{dec}f}"
    except Exception:
        return str(value)
    if LANG == "en":
        return s
    return s.replace(",", "X").replace(".", ",").replace("X", ".")


def hbytes(n, dec=1):
    try:
        n = float(n)
    except Exception:
        return "-"
    units = ["B", "KB", "MB", "GB", "TB", "PB"]
    i = 0
    while n >= 1024 and i < len(units) - 1:
        n /= 1024.0
        i += 1
    if i == 0:
        return f"{int(n)} B"
    return f"{fnum(n, dec)} {units[i]}"


def speed(n):
    return hbytes(n, 1) + "/s"


def cache_fmt(size):
    s = (size or "").strip()
    if not s:
        return "-"
    try:
        if s.endswith("K"):
            kb = int(s[:-1])
            if kb >= 1024:
                return fnum(kb / 1024.0, 0) + " MB"
        if s.endswith("M"):
            return s.replace("M", " MB")
    except Exception:
        pass
    return s


def ghz(mhz):
    if not mhz:
        return "-"
    if mhz >= 1000:
        return fnum(mhz / 1000.0, 2) + " GHz"
    return f"{int(mhz)} MHz"


def durasi(seconds):
    seconds = int(max(0, seconds))
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    if LANG == "en":
        if days:
            return f"{days} d {hours} h"
        if hours:
            return f"{hours} h {mins} m"
        return f"{mins} min"
    if days:
        return f"{days} hari {hours} jam"
    if hours:
        return f"{hours} jam {mins} menit"
    return f"{mins} menit"


def temp_color(t, warn=80):
    if t is None:
        return MUTED
    if t >= warn:
        return PINK
    if t >= warn - 15:
        return ORANGE
    return GREEN


def mix(c1, c2, t):
    """Campur dua warna hex, t=0 -> c1, t=1 -> c2."""
    try:
        a = tuple(int(c1[i:i + 2], 16) for i in (1, 3, 5))
        b = tuple(int(c2[i:i + 2], 16) for i in (1, 3, 5))
        c = tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))
        return "#%02x%02x%02x" % c
    except Exception:
        return c1


def round_rect(canvas, x1, y1, x2, y2, r, **kw):
    points = [
        x1 + r, y1, x2 - r, y1, x2 - r, y1, x2, y1, x2, y1 + r,
        x2, y2 - r, x2, y2 - r, x2, y2, x2 - r, y2, x1 + r, y2,
        x1 + r, y2, x1, y2, x1, y2 - r, x1, y1 + r, x1, y1 + r,
        x1, y1, x1 + r, y1,
    ]
    return canvas.create_polygon(points, smooth=True, **kw)


def run_cmd(cmd, timeout=3):
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              text=True, timeout=timeout).stdout.strip()
    except Exception:
        return ""


def powershell(command, timeout=5):
    if OS_NAME != "Windows":
        return ""
    return run_cmd(["powershell", "-NoProfile", "-NonInteractive",
                    "-Command", command], timeout=timeout)


def choose_fonts(root):
    """Pilih font yang tersedia di OS aktif."""
    global FONT, MONO
    try:
        families = set(tkfont.families(root))
    except Exception:
        return
    for candidate in ("Noto Sans", "Segoe UI", "Helvetica Neue",
                      "DejaVu Sans", "Liberation Sans", "Arial"):
        if candidate in families:
            FONT = candidate
            break
    for candidate in ("Noto Sans Mono", "Cascadia Mono", "Consolas", "Menlo",
                      "DejaVu Sans Mono", "Liberation Mono", "Courier New"):
        if candidate in families:
            MONO = candidate
            break


