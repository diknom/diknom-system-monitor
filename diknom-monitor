def main():
    start = "performance"
    args = sys.argv[1:]
    for i, a in enumerate(args):
        if a == "--page" and i + 1 < len(args):
            start = args[i + 1]
        elif a.startswith("--page="):
            start = a.split("=", 1)[1]
        elif a in ("-h", "--help"):
            print(f"{APP_NAME} v{VERSION}")
            print("Pemakaian: diknom-monitor [--page performance|hardware|"
                  "processes|storage|network|settings|about]")
            return 0
        elif a in ("-v", "--version"):
            print(f"{APP_NAME} v{VERSION}")
            return 0
    app = App(start_page=start)
    app.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
