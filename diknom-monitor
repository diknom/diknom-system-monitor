    # ------------------------------------------------------------------ metric
    def gather(self):
        now = time.monotonic()
        dt = max(0.05, now - self.last_t) if self.last_t else 1.0
        self.last_t = now
        m = self.m
        m["cpu"] = psutil.cpu_percent(None)
        m["cores"] = psutil.cpu_percent(None, percpu=True)
        try:
            m["freq"] = psutil.cpu_freq().current
        except Exception:
            m["freq"] = 0
        m["vm"] = psutil.virtual_memory()
        m["swap"] = psutil.swap_memory()
        m["zram"] = read_zram()
        m["battery"] = read_battery()
        m["load"] = psutil.getloadavg()[0]
        m["uptime"] = time.time() - psutil.boot_time()
        m["temps"], m["temps_map"] = self._read_temps()

        io = psutil.disk_io_counters()
        m["io_r"] = m["io_w"] = 0.0
        if io and self.prev_io:
            m["io_r"] = max(0.0, (io.read_bytes - self.prev_io.read_bytes) / dt)
            m["io_w"] = max(0.0, (io.write_bytes - self.prev_io.write_bytes) / dt)
        self.prev_io = io

        per = psutil.net_io_counters(pernic=True)
        m["rx"] = m["tx"] = 0.0
        if self.iface in per and self.prev_net and self.iface in self.prev_net:
            m["rx"] = max(0.0, (per[self.iface].bytes_recv -
                                self.prev_net[self.iface].bytes_recv) / dt)
            m["tx"] = max(0.0, (per[self.iface].bytes_sent -
                                self.prev_net[self.iface].bytes_sent) / dt)
        self.prev_net = per

        if now - getattr(self, "_disk_t", 0) > 20 or not hasattr(self, "disk_usage"):
            self.disk_usage = psutil.disk_usage(ROOT_MOUNT)
            self._disk_t = now

    def _read_temps(self):
        values = {}
        flat = {}
        try:
            sensors = psutil.sensors_temperatures()
        except Exception:
            sensors = {}
        for chip, entries in sensors.items():
            for idx, e in enumerate(entries):
                if e.current is None:
                    continue
                flat[(chip, e.label)] = e.current
                flat[(chip, idx)] = e.current
        for display, chip, label in temp_slots():
            if (chip, label) in flat:
                values[display] = flat[(chip, label)]
            elif chip in sensors and sensors[chip]:
                values[display] = sensors[chip][0].current
        if not values and "coretemp" in sensors and sensors["coretemp"]:
            values["CPU Package"] = sensors["coretemp"][0].current
        return values, flat

    # -------------------------------------------------------------------- tick
    def tick(self):
        interval = max(1, int(self.cfg.get("interval", 1)))
        if self.state() == "iconic":
            self.after(interval * 1000, self.tick)
            return
        try:
            self.gather()
        except Exception:
            pass
        try:
            if "performance" in self.pages:
                self.update_performance()
            if self.current_page == "network" and "network" in self.pages:
                self.update_network()
            if self.current_page == "processes":
                self.refresh_processes()
                if self.proc_ts > self.proc_shown:
                    self.proc_shown = self.proc_ts
                    self.render_procs()
            self.update_status()
        except Exception:
            pass
        self.after(interval * 1000, self.tick)

    def update_status(self):
        up = durasi(self.m.get("uptime", 0))
