class Spark(tk.Canvas):
    """Grafik garis ringan (polyline + area), tanpa library tambahan."""

    def __init__(self, parent, color, maxval=None, points=90, height=54, bg=CARD):
        super().__init__(parent, bg=bg, height=height, highlightthickness=0, bd=0)
        self.color = color
        self.maxval = maxval
        self.bg = bg
        self.values = deque(maxlen=int(points))
        self._line = None
        self._fill = None
        self.bind("<Configure>", lambda e: self.redraw())

    def set_points(self, n):
        self.values = deque(self.values, maxlen=max(10, int(n)))
        self.redraw()

    def push(self, value):
        try:
            v = float(value)
        except Exception:
            v = 0.0
        if not self.values and self.values.maxlen:
            self.values.extend([0.0] * (self.values.maxlen - 1))
        self.values.append(v)
        if self.winfo_ismapped():
            self.redraw()

    def _ensure(self):
        if self._line is None:
            self._fill = self.create_polygon(0, 0, 0, 0, 0, 0,
                                             fill=mix(self.color, self.bg, .62),
                                             outline="", smooth=True,
                                             splinesteps=10)
            self._line = self.create_line(0, 0, 0, 0, fill=self.color,
                                          width=2, capstyle="round",
                                          joinstyle="round", smooth=True,
                                          splinesteps=12)

    def redraw(self):
        w = max(self.winfo_width(), 2)
        h = max(self.winfo_height(), 2)
        if w <= 2 or h <= 2:
            return
        self._ensure()
        vals = list(self.values)
        if not vals:
            self.coords(self._line, 0, h, 0, h)
            self.coords(self._fill, 0, h, w, h, w, h)
            return
        mx = self.maxval if self.maxval else max(max(vals) * 1.25, 1e-9)
        n = len(vals)
        cap = self.values.maxlen or n
        step = w / max(1, cap - 1)
        x0 = w - (n - 1) * step
        pts = []
        for i, v in enumerate(vals):
            px = x0 + i * step
            py = h - 3 - min(max(float(v), 0) / mx, 1.0) * (h - 6)
            pts.extend([px, py])
        if n == 1:
            self.coords(self._line, x0, pts[1], w, pts[1])
            self.coords(self._fill, max(0, x0), h, x0, pts[1], w, pts[1], w, h)
        else:
            self.coords(self._line, *pts)
            self.coords(self._fill, max(0, x0), h, *pts, w, h)


