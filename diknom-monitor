def default_iface():
    try:
        with open("/proc/net/route") as f:
            lines = f.read().splitlines()[1:]
        for line in lines:
            parts = line.split()
            if len(parts) > 2 and parts[1] == "00000000":
                return parts[0]
    except Exception:
        pass
    try:
        stats = psutil.net_if_stats()
        for name, st in stats.items():
            if st.isup and name.lower() not in ("lo", "loopback"):
                return name
    except Exception:
        pass
    return "lo"


def read_zram():
    base = "/sys/block/zram0"
    if not os.path.isdir(base):
        return None
    try:
        disksize = read_int(base + "/disksize")
        fields = read(base + "/mm_stat").split()
        orig = int(fields[0]) if fields else 0
        comp = int(fields[1]) if len(fields) > 1 else 0
        algo = read(base + "/comp_algorithm")
        m = re.search(r"\[([^\]]+)\]", algo)
        algo = m.group(1) if m else "-"
        return {"disksize": disksize, "orig": orig, "comp": comp, "algo": algo}
    except Exception:
        return None


def win_battery_extra():
    if OS_NAME != "Windows":
        return {}
    out = powershell(
        "Get-CimInstance Win32_Battery | Select-Object -First 1 "
        "DesignCapacity,FullChargeCapacity,EstimatedChargeRemaining,"
        "BatteryStatus,PowerOnline,Name,Manufacturer,Chemistry | "
        "ConvertTo-Json -Compress", timeout=6)
    try:
        data = json.loads(out) if out else {}
    except Exception:
        return {}
    extra = {}
    try:
        design = float(data.get("DesignCapacity") or 0) / 1000.0
        full = float(data.get("FullChargeCapacity") or 0) / 1000.0
        if design > 0:
            extra["energy_design"] = design
        if full > 0:
            extra["energy_full"] = full
    except Exception:
        pass
    if data.get("EstimatedChargeRemaining") is not None:
        try:
            extra["percent"] = float(data["EstimatedChargeRemaining"])
        except Exception:
            pass
    if data.get("PowerOnline") is not None:
        extra["ac_online"] = bool(data["PowerOnline"])
    status_code = data.get("BatteryStatus")
    if status_code in (6, 7, 8, 9):
        extra["status"] = "Charging"
    elif status_code == 3:
        extra["status"] = "Full"
    elif data.get("PowerOnline") is False:
        extra["status"] = "Discharging"
    for src, dst in (("Name", "model"), ("Manufacturer", "manufacturer"),
                     ("Chemistry", "technology")):
        if data.get(src):
            extra[dst] = str(data[src])
    return extra


def mac_battery_extra():
    if OS_NAME != "Darwin":
        return {}
    extra = {}
    out = run_cmd(["system_profiler", "SPPowerDataType"], timeout=8)
    for line in out.splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if key == "Cycle Count":
            try:
                extra["cycles"] = int(value)
            except Exception:
                pass
        elif key == "Maximum Capacity":
            m = re.search(r"(\d+)", value)
            if m:
                extra["health"] = float(m.group(1))
        elif key == "Condition":
            extra["condition"] = value
    pmset = run_cmd(["pmset", "-g", "batt"], timeout=4)
    if "AC Power" in pmset:
        extra["ac_online"] = True
    elif "Battery Power" in pmset:
        extra["ac_online"] = False
    return extra


def battery_static_extra():
    global _BAT_STATIC
    if _BAT_STATIC is None:
