    def _iface_info(self):
        out = {"ip": "-", "mac": "-"}
        try:
            addrs = psutil.net_if_addrs().get(self.iface, [])
            for a in addrs:
                if a.family == 2:
                    out["ip"] = a.address
                elif (getattr(a, "family", None) ==
                      getattr(psutil, "AF_LINK", -1)
                      and a.address and a.address.count(":") == 5):
                    out["mac"] = a.address
                elif (a.address and len(a.address) == 17
                      and a.address.count(":") == 5):
                    out["mac"] = a.address
            if out["mac"] == "-" and addrs:
                last = addrs[-1].address
                if last and len(last) == 17 and last.count(":") == 5:
                    out["mac"] = last
        except Exception:
            pass
        return out

    def _wifi_summary(self):
        wifi = wifi_info(self.iface)
        parts = []
        if wifi.get("ssid"):
            parts.append(wifi["ssid"])
        if wifi.get("signal"):
            parts.append(f"{tr('sinyal')} {wifi['signal']}")
        if wifi.get("freq"):
            parts.append(wifi["freq"])
        return "  ·  ".join(parts) if parts else ""

    # --------------------------------------------------------- perf updater
    def update_performance(self):
        m = self.m
        if not m:
            return
        w = self.w
        cpu = m.get("cpu", 0)
        warn = self.cfg.get("temp_warn", 80)

        color = GREEN if cpu < 70 else (ORANGE if cpu < 90 else PINK)
        self.set_big("cpu", f"{cpu:.0f}%", color)
        w["cpu"]["sub"].config(text=ghz(m.get("freq", 0)))
        pkg = m.get("temps", {}).get("CPU Package")
        if pkg is not None:
            w["cpu"]["badge"].config(text=f"{pkg:.0f} °C", fg=temp_color(pkg, warn))
        else:
            w["cpu"]["badge"].config(text="")
        w["cpu"]["spark"].push(cpu)
        w["gauge"].set(cpu, color)

        vm = m.get("vm")
        if vm:
            self.set_big("ram", f"{vm.percent:.0f}%")
            w["ram"]["sub"].config(
                text=f"{hbytes(vm.used)} / {hbytes(vm.total)}  ·  "
                     f"{tr('tersedia')} {hbytes(vm.available)}")
            w["ram"]["spark"].push(vm.percent)

        z = m.get("zram")
        if z:
            ratio = (z["orig"] / z["comp"]) if z["comp"] else 0
            self.set_big("zram", hbytes(z["orig"]))
            w["zram"]["sub"].config(
                text=f"{tr('rasio')} {fnum(ratio, 1)}x  ·  "
                     f"{hbytes(z['comp'])} {tr('di RAM')}  ·  {z['algo']}")
            w["zram"]["spark"].push(z["orig"] / 1048576.0)
        else:
            self.set_big("zram", "-")
            w["zram"]["sub"].config(text="ZRAM tidak aktif")

        sw = m.get("swap")
        if sw:
            self.set_big("swap", hbytes(sw.used))
            w["swap"]["sub"].config(
                text=f"({sw.percent:.0f}%) {tr('dari')} {hbytes(sw.total)}  ·  "
                     f"zram + /swap.img")
            w["swap"]["spark"].push(sw.used / 1048576.0)

        r = m.get("io_r", 0) / 1048576.0
        wr = m.get("io_w", 0) / 1048576.0
        self.set_big("disk", speed(r * 1048576 + wr * 1048576))
        w["disk"]["sub"].config(
            text=f"{tr('Baca')} {speed(r * 1048576)}  ·  "
                 f"{tr('Tulis')} {speed(wr * 1048576)}")
        w["disk"]["spark"].push(r + wr)

        rx = m.get("rx", 0)
        tx = m.get("tx", 0)
        self.set_big("net", speed(rx + tx))
        w["net"]["sub"].config(text=f"↓ {speed(rx)}  ·  ↑ {speed(tx)}")
        w["net"]["spark"].push((rx + tx) / 1048576.0)
        if "net_panel_spark" in w:
            w["net_panel_spark"].push((rx + tx) / 1048576.0)
            w["net_big"].config(text=speed(rx + tx))
            w["net_sub"].config(text=f"↓ {speed(rx)}  ·  ↑ {speed(tx)}")

        if hasattr(self, "stor_io") and self.stor_io.winfo_exists():
            self.stor_io.push((m.get("io_r", 0) + m.get("io_w", 0)) / 1048576.0)
            self.stor_io_lbl.config(
                text=f"{tr('Baca')} {speed(m.get('io_r', 0))}  ·  "
                     f"{tr('Tulis')} {speed(m.get('io_w', 0))}")

        # per core
        cores = m.get("cores") or []
        temps = m.get("temps", {})
        for i, row in enumerate(getattr(self, "core_rows", [])):
            if i < len(cores):
                p = cores[i]
                row["val"].config(text=f"{p:.0f}%")
                row["spark"].push(p)
            t = temps.get(f"Core {i}")
            if t is not None:
                row["temp"].config(text=f"{t:.0f} °C", fg=temp_color(t, warn))

        # panel suhu
        for display, (val, bar) in getattr(self, "temp_labels", {}).items():
            t = temps.get(display)
            if t is None:
                val.config(text="-")
                continue
            val.config(text=f"{t:.0f} °C", fg=temp_color(t, warn))
            try:
                bar.delete("all")
                bar.create_rectangle(0, 0, 3, 16, fill=temp_color(t, warn), outline="")
            except Exception:
                pass

        u = getattr(self, "disk_usage", None)
        if u:
            w["disk_bar"].config(value=u.percent)
            w["disk_used"].config(
                text=f"{tr('Terpakai')} {hbytes(u.used)}")
            w["disk_free"].config(
                text=f"{tr('Bebas')} {hbytes(u.free)}  ·  "
                     f"{tr('total')} {hbytes(u.total)}")
            w["disk_pct"].config(text=f"{u.percent:.0f}%")

        # baterai
        bat = m.get("battery")
        if bat and "bat_pct" in w:
            pct = bat.get("percent", 0)
            bcolor = GREEN if pct >= 40 else (ORANGE if pct >= 15 else PINK)
            w["bat_pct"].config(text=f"{pct:.0f}", fg=bcolor)
            w["bat_pct_unit"].config(fg=bcolor)
            status = battery_status_text(bat)
            plugged = bat.get("plugged") or bat.get("ac_online")
            stcolor = GREEN if plugged else (ORANGE if pct > 20 else PINK)
